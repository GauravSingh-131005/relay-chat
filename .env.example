# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Any LiteLLM model name that matches your keys' provider.
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite file; /data is the Docker volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins (your deployed frontend URL in production).
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT=30

# Frontend build-time setting: where the browser finds the backend.
VITE_API_URL=http://localhost:8000
